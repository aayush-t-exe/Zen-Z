# Claude Code's own local workspace scaffolding — not part of the app,
# never checked into git. .agents/skills and agent/skills contain symlinks
# into .claude/skills that EAS's Windows-based project archiving step can't
# recreate (EPERM: operation not permitted, symlink ...), which fails the
# "Compressing project files" step before a build ever starts.
.claude/
.agents/
agent/
.impeccable/
skills-lock.json

# EAS reinstalls dependencies on its own servers, and these workspaces
# aren't needed for the mobile build — excluding them cut the uploaded
# tarball from 385MB (root node_modules alone was 1.3GB, apps/admin 1.8GB)
# down drastically, making uploads faster and less likely to hit
# mid-transfer network errors.
node_modules/
apps/admin/
apps/marketing/
